{
  "name": "workout-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:release": "npm run check:lockfile && npm run build && npm run check:artifact && npm run test:e2e -- --workers=4 && npm run test:production",
    "check:lockfile": "node scripts/check-release-lockfile.mjs",
    "test:production": "playwright test -c playwright.production.config.ts",
    "check:artifact": "node scripts/check-production-artifact.mjs"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
